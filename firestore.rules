rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'thijs.buisman@student.hu.nl' ||
        request.auth != null
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    match /evidence/{evidenceId} {
      allow read: if true;
      allow write: if true;
    }

    match /sprints/{sprintId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
