{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student portfolio profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "studentNumber": { "type": "string" },
        "studyTrack": { "type": "string" },
        "institution": { "type": "string" },
        "minor": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["name", "minor"]
    },
    "EvidenceItem": {
      "title": "EvidenceItem",
      "description": "Sprint evidence deliverable and HU reflection",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "sprintId": { "type": "number" },
        "date": { "type": "string" },
        "investigated": { "type": "string" },
        "created": { "type": "string" },
        "learned": { "type": "string" },
        "evaluationStatus": { "type": "string" }
      },
      "required": ["title", "sprintId", "investigated", "created", "learned"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": "UserProfile",
      "description": "Profile data for student"
    },
    "/evidence/{evidenceId}": {
      "schema": "EvidenceItem",
      "description": "Individual sprint evidence documents"
    }
  }
}
